# ============================================================
# LuckyDraw Demo Platform - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django Core
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=gaming_platform
DB_USER=gaming_user
DB_PASSWORD=strongpassword123
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Demo Platform
DEMO_SIGNUP_BONUS=1000

# CORS (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Security (set to True in production with HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False





# ─────────────────────────────────────────────────────────────
# ADD THESE TO: .env.example  (and your actual .env)
# ─────────────────────────────────────────────────────────────

# Deposit UPI Configuration
DEPOSIT_UPI_ID=yourname@paytm
DEPOSIT_UPI_NAME=Your Business Name
DEPOSIT_QR_IMAGE=img/deposit_qr.png
DEPOSIT_MIN=100
DEPOSIT_MAX=50000

# Withdraw Configuration
WITHDRAW_MIN=200
WITHDRAW_MAX=50000